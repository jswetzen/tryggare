DJANGO_SETTINGS_MODULE=config.settings.local
SECRET_KEY=change-me
DEBUG=true
DATABASE_URL=postgresql://postgres:postgres@db:5432/checkins
ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VALKEY_URL=redis://valkey:6379/0
SESSION_COOKIE_SECURE=false
CSRF_COOKIE_SECURE=false

# Demo mode: shows credentials on the login page and reseeds/resets data
# hourly. This is local dev, holds no real user data, and is the environment
# self-serve registration gets tested in — keep this true here.
DEMO_MODE=true

# Email (SMTP) — optional. Leave EMAIL_HOST blank for no email sending
# (safe default for local dev; see notifications/providers.py). With
# DEMO_MODE=true above, an unset EMAIL_HOST is a supported state, not a
# misconfiguration, and notifications/apps.py won't refuse to start.
EMAIL_PROVIDER=smtp
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=
# Only needed when DEMO_MODE=false and EMAIL_HOST is blank: acknowledges
# "yes, I really am running this deployment without email" so startup logs a
# warning instead of refusing to boot. Never set true by default — see
# notifications/apps.py.
EMAIL_DISABLED_ACK=

# Swish/Bankgiro payee config (registrations/swish.py) — optional. Leave
# blank to skip that payment rail's instructions (blank-safe, single-tenant:
# one congregation, one number each).
SWISH_PAYEE_NUMBER=
BANKGIRO_NUMBER=
